# ~/.hermes/.env 에 복사해서 사용하세요. 이 파일 자체는 커밋하지 마세요.
# Hermes 규칙: 비밀값은 .env, 나머지 설정은 config.yaml

# --- LLM 공급자 (하나만 있으면 됩니다) ---
ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=

# --- YouTube Data API v3 / Analytics API ---
# Google Cloud Console에서 "데스크톱 앱" OAuth 클라이언트를 만들고
# 내려받은 client_secret.json 의 경로를 지정합니다.
YOUTUBE_CLIENT_SECRETS=/home/YOUR_USER/.hermes/secrets/youtube_client_secret.json
# 최초 인증 후 토큰이 저장될 경로 (scripts/youtube_upload.py 가 자동 생성)
YOUTUBE_TOKEN_STORE=/home/YOUR_USER/.hermes/secrets/youtube_token.json

# Higgsfield 는 OAuth 라서 키가 필요 없습니다.
# `hermes mcp login higgsfield` 로 인증하면 Hermes 가 토큰을 관리합니다.
